datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SK_OFFICIAL
  KK_YOUTH
  TESDA_PARTNER
  BARANGAY_CAPTAIN
}

enum ApprovalStatus {
  Approved
  Pending
  Rejected
}

enum ProgramType {
  Training
  Employment
  Entrepreneurship
}

enum ProgramCost {
  Free
  Subsidized
  With_Fee
}

enum ProgramStatus {
  Active
  Full
  Closed
}

enum ReferralStatus {
  Pending
  Enrolled
  Declined
  Archived
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  name          String
  role          Role
  barangayId    String?
  barangay      Barangay?        @relation(fields: [barangayId], references: [id])
  status        String           @default("Active")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  contactNumber String?
  youthProfile           YouthProfile?
  officialAcc            OfficialAccount?
  councilor              Councilor?
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  publishedPrograms      TESDAProgram[]
}

model Barangay {
  id               String            @id @default(cuid())
  name             String            @unique
  users            User[]
  youthProfiles    YouthProfile[]
  officialAccounts OfficialAccount[]
  announcements    SKAnnouncement[]
  councilors       Councilor[]
}

model Category {
  id          String         @id
  name        String         @unique
  slug        String         @unique
  description String?
  aliases     Alias[]
  programs    TESDAProgram[]
}

model Alias {
  id              String   @id @default(cuid())
  alias           String
  normalizedValue String
  categoryId      String

  category        Category @relation(fields: [categoryId], references: [id])

  @@unique([alias, categoryId])
  @@index([alias])
}

model YouthProfile {
  id                      String         @id @default(cuid())
  userId                  String?        @unique
  user                    User?          @relation(fields: [userId], references: [id])
  name                    String
  firstName               String?
  lastName                String?
  birthdate               DateTime?
  age                     Int
  gender                  String?
  purok                   String
  barangayId              String
  barangay                Barangay       @relation(fields: [barangayId], references: [id])
  educationalAttainment   String
  currentStatus           String         // "Out-of-school" | "In-school" | "Employed" | "Self-employed" | "Graduate"
  
  // Legacy / Compatibility fields
  skills                  String[]       // Array of skill strings
  interests               String[]       // Array of interest strings
  sectorPreference        String
  livelihoodGoal          String
  
  // CBF Raw inputs
  skillsRaw               String[]       @default([])
  preferencesRaw          String[]       @default([])
  experiencesRaw          String[]       @default([])
  goalRaw                 String?

  // CBF Normalized JSON data
  skillsNormalized        Json           @default("[]")
  preferencesNormalized   Json           @default("[]")
  experiencesNormalized   Json           @default("[]")
  goalNormalized          Json?

  contactNumberEncrypted   String         // AES-256-GCM Encrypted
  registeredDate          DateTime       @default(now())
  matchScore              Float          @default(0)
  soloParent              Boolean        @default(false)
  pwd                     Boolean        @default(false)
  indigenous              Boolean        @default(false)
  hasReferred             Boolean        @default(false)
  approvalStatus          ApprovalStatus @default(Approved)
  verificationIdType      String?
  verificationIdNumberEnc String?        // AES-256-GCM Encrypted
  verificationIdImageEnc  String?        // AES-256-GCM Encrypted
  profilePicture          String?        // User Profile Avatar URL or Base64
  savedCareerPlan         String?        // JSON or formatted text of Gemini Career Plan
  savedMatchAdvice        String?        // JSON text of Cached Featured AI Match Advice
  referrals               Referral[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

model TESDAProgram {
  id                 String        @id @default(cuid())
  title              String
  provider           String
  type               ProgramType
  location           String
  trainingHours      Int
  cost               ProgramCost   @default(Free)
  slotsTotal         Int
  slotsRemaining     Int
  youthMatched       Int           @default(0)
  eligibility        String
  contactPerson      String
  contactNumber      String
  activeStatus       ProgramStatus @default(Active)
  requiredDocuments  String[]
  requiredSkills     String[]
  trainingDays       String[]
  startTime          DateTime?
  endTime            DateTime?
  room               String?
  instructor         String?
  startDate          DateTime?
  endDate            DateTime?
  deliveryMode       String?       @default("Face-to-Face")
  fundingType        String?       @default("Free")
  perks              String[]      @default([])
  cptrCourseCode     String?
  certificationType  String?       @default("National Certificate")
  
  // Category relation
  categoryId         String?
  category           Category?     @relation(fields: [categoryId], references: [id])
  
  partnerId          String?
  partner            User?         @relation(fields: [partnerId], references: [id])
  referrals          Referral[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model SKAnnouncement {
  id            String    @id @default(cuid())
  title         String
  body          String
  category      String    // "Program Update" | "Event" | "Reminder" | "General"
  audience      String    // "All KK members" | "OSY only"
  eventDate     String?
  venue         String?
  contactPerson String?
  status        String    @default("Active") // "Active" | "Cancelled"
  expiryDate    DateTime?
  barangayId    String?
  barangay      Barangay? @relation(fields: [barangayId], references: [id])
  datePosted    DateTime  @default(now())
}

model Referral {
  id           String         @id @default(cuid())
  youthId      String
  youth        YouthProfile   @relation(fields: [youthId], references: [id])
  programId    String
  program      TESDAProgram   @relation(fields: [programId], references: [id])
  matchScore   Float
  referralDate DateTime       @default(now())
  status       ReferralStatus @default(Pending)
}

model OfficialAccount {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  name       String
  email      String
  role       String    // "SK Chairperson" | "Barangay Captain" | "TESDA Representative"
  barangayId String?
  barangay   Barangay? @relation(fields: [barangayId], references: [id])
  status          String    @default("Active")
  institutionName String?
  providerType    String?
  cptrNumber      String?
  contactNumber   String?
  createdAt       DateTime  @default(now())
}

model Councilor {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])
  name          String
  email         String
  role          String   // "SK Councilor" | "Secretary" | "Treasurer"
  contactNumber String?
  status        String   @default("Active")
  barangayId    String
  barangay      Barangay @relation(fields: [barangayId], references: [id])
  createdAt     DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model NotificationPreference {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled               Boolean  @default(true)
  emailEnabled              Boolean  @default(true)
  notifyOnApplicationStatus Boolean  @default(true)
  notifyOnAnnouncements     Boolean  @default(true)
  notifyOnNewRegistrations  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}


model ProviderApplication {
  id                     String    @id @default(cuid())
  institutionName        String
  providerType           String    // "Public TESDA Institute" | "Private TVET Institute" | "LGU Training Center" | "HEI / SUC"
  campusAddress          String
  representativeName     String
  representativePosition String
  email                  String    @unique
  contactNumber          String
  passwordHash           String
  cptrNumber             String    // Certificate of TVET Program Registration Number
  cptrDocument           String    // Base64 document/image upload of CPTR
  status                 String    @default("Pending") // "Pending" | "Approved" | "Rejected"
  rejectionReason        String?
  reviewedBy             String?
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}


model AppVerificationCode {
  id              String    @id @default(cuid())
  email           String
  code            String
  type            String    @default("REGISTER") // "REGISTER" | "RESET_PASSWORD"
  expiresAt       DateTime
  attempts        Int       @default(0)
  lastRequestedAt DateTime  @default(now())
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  metadata        String?   // JSON for extra context like userId or name
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([email, type])
  @@index([email, type])
}
